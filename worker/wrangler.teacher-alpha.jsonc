{
  // Teacher web alpha (branch `teacher`): only hosts the Flutter web build
  // and the WebUntis relay (/proxy/...). No database, no sync, no cron:
  // /api/sync/* answers 404 sync_disabled (src/index.ts), and the web build
  // is made with --dart-define=BBU_NO_SYNC=true.
  // Deployed by hand: tool/deploy_teacher_alpha.sh
  // → https://bbu-teacher-alpha.brandart1.workers.dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bbu-teacher-alpha",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // Filled by tool/deploy_teacher_alpha.sh (gitignored).
    "directory": "./public-teacher-alpha",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/proxy/*", "/api/*", "/healthz"]
  },
  "ratelimits": [
    // /proxy/*, per client IP (same as production).
    { "name": "RL_PROXY", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_HOSTS": "webuntis.com,*.webuntis.com",
    "PUBLIC_ORIGIN": "https://bbu-teacher-alpha.brandart1.workers.dev"
  },
  "observability": {
    "enabled": false
  }
}
