{
  // BetterBetterUntis Worker: serves the Flutter web build (static assets),
  // relays WebUntis requests (/proxy/...) and hosts the optional notes sync
  // (/api/sync/...) on D1. See ../docs/SYNC-PLAN.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-betteruntis",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Alpha releases are uploaded as versions with the preview alias "alpha"
  // (https://alpha-better-betteruntis.<subdomain>.workers.dev), see
  // .github/workflows/release.yml; that needs preview URLs.
  "preview_urls": true,
  "assets": {
    // Filled by CI with `flutter build web` output (+ _headers).
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs first for /proxy/* and /api/* only; everything else
    // is served straight from the assets.
    "run_worker_first": ["/proxy/*", "/api/*", "/healthz"]
  },
  // Daily cleanup (scheduled handler in index.ts): expired sync sessions and
  // tombstones not written for 400 days.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bbu-sync",
      // Placeholder until the maintainer creates the database
      // (`wrangler d1 create bbu-sync`); local dev/tests don't need it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Workers rate limiting (per key, per Cloudflare location; period 10 or 60 s).
  // IP keys use the IPv6 /64 prefix (src/ip.ts).
  "ratelimits": [
    // POST /api/sync/session, per client IP (30: a school NAT where a class
    // turns sync on together).
    { "name": "RL_SESSION", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // /proxy/*, per client IP.
    { "name": "RL_PROXY", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    // Every authenticated sync call, per identity (after the session lookup).
    { "name": "RL_SYNC", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    // Writes (PUT notes, PUT/PATCH/DELETE e2e), per identity, on top of RL_SYNC.
    { "name": "RL_WRITE", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    // FAILED session lookups (unknown/expired token), per client IP; an IP
    // over the limit is blocked for 60 s before D1 is asked (src/sync/auth.ts).
    { "name": "RL_AUTH", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_HOSTS": "webuntis.com,*.webuntis.com",
    "PUBLIC_ORIGIN": "https://better-betteruntis.eu"
  },
  "observability": {
    // Invocation logs stay off: they could contain request URLs.
    "enabled": false
  }
}
