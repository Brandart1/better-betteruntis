{
  "name": "bbu-worker",
  "private": true,
  "description": "BetterBetterUntis Cloudflare Worker: web app hosting, WebUntis relay, optional notes sync (D1).",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply bbu-sync --local",
    "migrate:remote": "wrangler d1 migrations apply bbu-sync --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "workerd@1.20261113.1": true,
    "esbuild@0.28.2": true
  }
}
