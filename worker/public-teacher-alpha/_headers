# Cloudflare static-assets headers (copied next to the Flutter web build by CI).
# Same headers as the old Dart server (removed in 0.5.0), plus no framing
# (X-Frame-Options, CSP frame-ancestors only: a full CSP would break
# Flutter's inline bootstrap/wasm) and HSTS.
# Without a Cache-Control rule assets get Cloudflare's default
# "public, max-age=0, must-revalidate" (revalidate with ETag), which covers
# SPA routes served from index.html. Rules below don't overlap, so each path
# gets exactly one Cache-Control value.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000

# Not content-hashed in a Flutter web build (index.html, main.dart.js,
# flutter_bootstrap.js, flutter_service_worker.js, version.json,
# manifest.json, canvaskit/*.js|wasm, AssetManifest.json, ...): always revalidate.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.mjs
  Cache-Control: no-cache
/*.wasm
  Cache-Control: no-cache
/*.json
  Cache-Control: no-cache
/*.map
  Cache-Control: no-cache
/*.webmanifest
  Cache-Control: no-cache

# Images, fonts, shaders and other static files: one day.
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.gif
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
/*.otf
  Cache-Control: public, max-age=86400
/*.ttf
  Cache-Control: public, max-age=86400
/*.woff
  Cache-Control: public, max-age=86400
/*.woff2
  Cache-Control: public, max-age=86400
/*.bin
  Cache-Control: public, max-age=86400
/*.frag
  Cache-Control: public, max-age=86400
/*.css
  Cache-Control: public, max-age=86400
